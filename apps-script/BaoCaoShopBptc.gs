  // Nút (ảnh có gán hàm) – đặt bên phải, ngoài vùng in
  if (sh.getMaxColumns() < 11) sh.insertColumnsAfter(sh.getMaxColumns(), 11 - sh.getMaxColumns()); sh.setColumnWidth(10, 20); sh.setColumnWidth(11, 210);
  tqnBcAnh_(sh, TQN_BC.IMG.XUAT, 'image/png', 11, 6, 0, 0).assignScript('tqnXuatBaoCaoShopBptc');
  tqnBcAnh_(sh, TQN_BC.IMG.MOI, 'image/png', 11, 9, 0, 0).assignScript('tqnTaoBaoCaoShopBptc');
  sh.setFrozenRows(0); sh.setHiddenGridlines(true); ss.setActiveSheet(sh);
  SpreadsheetApp.flush(); return { tab: TQN_BC.TAB, dong: row };
}
/** Nút Xuất: mở hộp thoại có link tải PDF (A4 ngang, vừa chiều ngang, chỉ cột A:I) và Excel – trình duyệt tải bằng quyền của người bấm, không cần thêm quyền */
function tqnXuatBaoCaoShopBptc() {
  var ss = SpreadsheetApp.getActiveSpreadsheet(), sh = ss.getSheetByName(TQN_BC.TAB); if (!sh) { tqnTaoBaoCaoShopBptc(); sh = ss.getSheetByName(TQN_BC.TAB); }
  SpreadsheetApp.flush();
  var base = 'https://docs.google.com/spreadsheets/d/' + ss.getId() + '/export?gid=' + sh.getSheetId(), last = sh.getLastRow();
  var pdf = base + '&format=pdf&size=A4&portrait=false&fitw=true&gridlines=false&sheetnames=false&printtitle=false&pagenum=CENTER&horizontal_alignment=CENTER&top_margin=0.4&bottom_margin=0.4&left_margin=0.3&right_margin=0.3&range=A1:I' + last;
  var xlsx = base + '&format=xlsx';
  var ten = 'BC_Shop_BPTC_' + Utilities.formatDate(new Date(), ss.getSpreadsheetTimeZone(), 'yyyyMMdd');
  var h = '<div style="font:14px Arial;padding:6px"><p><b>' + ten + '</b></p>'
    + '<p><a href="' + pdf + '" target="_blank" style="display:inline-block;background:#1B3F7A;color:#fff;padding:9px 16px;border-radius:6px;text-decoration:none">⤓ Tải PDF (A4 ngang)</a> '
    + '<a href="' + xlsx + '" target="_blank" style="display:inline-block;background:#1F8A8A;color:#fff;padding:9px 16px;border-radius:6px;text-decoration:none">⤓ Tải Excel</a></p>'
    + '<p style="color:#666;font-size:12px">Muốn số liệu mới nhất: bấm LÀM MỚI trên tờ báo cáo trước khi xuất.</p></div>';
  SpreadsheetApp.getUi().showModalDialog(HtmlService.createHtmlOutput(h).setWidth(420).setHeight(170), 'Xuất báo cáo Shop / BPTC');
}
