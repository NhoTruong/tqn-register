
/* ===== TQN BÁO CÁO SHOP DRAWING + BPTC cho sếp (21/11) – tab "BC SHOP-BPTC", đầu trang theo mẫu phiếu RFI, nút Xuất PDF/Excel ===== */
var TQN_BC = { TAB: 'BC SHOP-BPTC', NGUON: [['SD', 'Shop drawing'], ['M0S', 'Biện pháp thi công']], NGAY_CHO: 7,
  IMG: { COA: '', TBC: '', XUAT: '', MOI: '' } };
function tqnBcBo_(s) { return String(s == null ? '' : s).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/g, 'd').replace(/\s+/g, ' ').trim(); }
function tqnBcNgay_(v) { if (v instanceof Date && !isNaN(v)) return v; var m = /^(\d{1,2})\/(\d{1,2})\/(\d{2,4})/.exec(String(v || '')); if (!m) return null; var y = +m[3]; if (y < 100) y += 2000; return new Date(y, +m[2] - 1, +m[1]); }
function tqnBcLoai_(tt) {
  var t = tqnBcBo_(tt);
  if (!t || /chua trinh|dang thuc hien|dang lam/.test(t)) return 'CHUA';
  if (/khong duyet|tu choi|tra ve|trinh lai|sua lai|ra soat lai|bo sung/.test(t)) return 'TRAVE';
  if (/da duyet|da phe duyet|chap thuan|duyet co y kien|da phan hoi|hoan thanh|dong/.test(t)) return 'DUYET';
  return 'CHO';
}
function tqnBcDoc_(ss, tab) {
  var sh = ss.getSheetByName(tab); if (!sh) return null;
  var v = sh.getDataRange().getValues(), H = v.slice(0, Math.min(6, v.length)), col = {}, nt = -1;
  H.forEach(function (r) { r.forEach(function (x, c) { var t = tqnBcBo_(x);
    if (t === 'ma ho so' && col.ma == null) col.ma = c; else if (t.indexOf('noi dung') === 0 && col.nd == null) col.nd = c;
    else if (t.indexOf('nguoi thuc hien') === 0 && col.nguoi == null) col.nguoi = c; else if (t.indexOf('tinh trang') === 0 && col.tt == null) col.tt = c;
    else if (t === 'rev' && col.rev == null) col.rev = c; else if (t.indexOf('nha thau de trinh') === 0) nt = c;
    else if (t.indexOf('vuong mac') === 0 && col.vm == null) col.vm = c; }); });
  if (nt >= 0) H.forEach(function (r) { for (var c = nt; c < nt + 4 && c < r.length; c++) if (col.ngay == null && /^thuc te$/.test(tqnBcBo_(r[c]))) col.ngay = c; });
  if (col.ma == null || col.nd == null) return { loi: 'Không dò được cột Mã/Nội dung ở tab ' + tab, ds: [] };
  var dau = 0; H.forEach(function (r, i) { if (r.some(function (x) { return /^stt$/i.test(String(x).trim()); })) dau = i + 1; });
  var ds = [], homNay = new Date();
  for (var i = dau; i < v.length; i++) {
    var r = v[i], ma = String(r[col.ma] || '').trim(), nd = String(r[col.nd] || '').trim();
    if (!ma && !nd) continue; if (!ma || !/\d/.test(ma) || /^(nam \d{4}|[ivx]+\.?)$/i.test(tqnBcBo_(ma))) continue;   // bỏ dòng mục (KẾT CẤU, I, NĂM 2026…)
    var tt = col.tt != null ? String(r[col.tt] || '').trim() : '', loai = tqnBcLoai_(tt), ng = col.ngay != null ? tqnBcNgay_(r[col.ngay]) : null;
    var cho = (loai === 'CHO' && ng) ? Math.floor((homNay - ng) / 864e5) : '';
    ds.push({ ma: ma, nd: nd.replace(/\s+/g, ' '), nguoi: col.nguoi != null ? String(r[col.nguoi] || '') : '', rev: col.rev != null ? String(r[col.rev] || '') : '',
      tt: tt || '(chưa ghi)', loai: loai, ngay: ng, cho: cho, vm: col.vm != null ? String(r[col.vm] || '') : '', dong: i + 1 });
  }
  return { ds: ds };
}
function tqnBcAnh_(sh, b64, mime, col, row, ox, oy) { return sh.insertImage(Utilities.newBlob(Utilities.base64Decode(b64), mime, 'h'), col, row, ox || 0, oy || 0); }
/** Tạo / làm mới tờ báo cáo (chỉ ghi vào tab BC SHOP-BPTC, không sửa sổ gốc) */
function tqnTaoBaoCaoShopBptc() {
  var ss = SpreadsheetApp.getActiveSpreadsheet(), sh = ss.getSheetByName(TQN_BC.TAB) || ss.insertSheet(TQN_BC.TAB);
  sh.getImages().forEach(function (im) { im.remove(); }); sh.clear(); sh.clearConditionalFormatRules && sh.clearConditionalFormatRules();
  try { sh.getRange(1, 1, sh.getMaxRows(), sh.getMaxColumns()).breakApart(); } catch (e) { }
  if (sh.getMaxColumns() < 9) sh.insertColumnsAfter(sh.getMaxColumns(), 9 - sh.getMaxColumns());
  var W = [40, 190, 330, 55, 150, 95, 70, 120, 150]; W.forEach(function (w, i) { sh.setColumnWidth(i + 1, w); });
  var N = 9, R = function (r, c, nr, nc) { return sh.getRange(r, c, nr || 1, nc || 1); };
  sh.getRange(1, 1, sh.getMaxRows(), N).setFontFamily('Arial').setFontSize(10).setVerticalAlignment('middle');
