  sh.setRowHeights(1, 3, 22); R(1, 1, 3, 3).merge(); R(1, 4, 3, 3).merge(); R(1, 7, 3, 3).merge();
  R(1, 1, 3, N).setBorder(true, true, true, true, true, false, '#000000', SpreadsheetApp.BorderStyle.SOLID);
  R(4, 1, 1, 5).merge().setValue('Dự án: Khu đô thị sinh thái Coastal Quảng Ngãi').setFontFamily('Times New Roman').setFontSize(12);
  R(4, 6, 1, 4).merge().setValue('Địa chỉ: xã Tư Nghĩa, tỉnh Quảng Ngãi').setFontFamily('Times New Roman').setFontSize(12);
  R(4, 1, 1, N).setBorder(true, true, true, true, false, false); sh.setRowHeight(4, 26);
  tqnBcAnh_(sh, TQN_BC.IMG.COA, 'image/jpeg', 2, 1, 40, 2).setWidth(150).setHeight(68);
  tqnBcAnh_(sh, TQN_BC.IMG.TBC, 'image/png', 8, 1, 60, 2).setWidth(70).setHeight(66);
  R(6, 1, 1, N).merge().setValue('BÁO CÁO TÌNH HÌNH TRÌNH DUYỆT SHOP DRAWING & BIỆN PHÁP THI CÔNG').setBackground('#C6E0B4').setFontWeight('bold').setFontSize(13).setHorizontalAlignment('center').setBorder(true, true, true, true, false, false);
  sh.setRowHeight(6, 30);
  var homNay = new Date(), tz = ss.getSpreadsheetTimeZone();
  R(7, 1, 1, N).merge().setValue('Ngày lập: ' + Utilities.formatDate(homNay, tz, 'dd/MM/yyyy HH:mm') + '   ·   Người lập: ' + Session.getActiveUser().getEmail() + '   ·   Nguồn: tab SD, M0S (đọc tự động, không sửa sổ gốc)').setFontStyle('italic').setFontColor('#555555').setHorizontalAlignment('center');
  // Bảng tổng hợp
  var row = 9; R(row, 1, 1, N).setValues([['', 'Hạng mục', 'Tổng hồ sơ', '', 'Đã duyệt', 'Đang chờ duyệt', 'Bị trả về', 'Chưa trình', 'Chờ > ' + TQN_BC.NGAY_CHO + ' ngày']]);
  R(row, 3, 1, 2).merge(); R(row, 1, 1, N).setBackground('#1B3F7A').setFontColor('#ffffff').setFontWeight('bold').setHorizontalAlignment('center').setWrap(true); sh.setRowHeight(row, 30);
  var data = TQN_BC.NGUON.map(function (n) { var d = tqnBcDoc_(ss, n[0]); return { tab: n[0], ten: n[1], d: d }; });
  data.forEach(function (x, k) {
    var ds = (x.d && x.d.ds) || [], dem = function (l) { return ds.filter(function (o) { return o.loai === l; }).length; };
    var tre = ds.filter(function (o) { return o.cho !== '' && o.cho > TQN_BC.NGAY_CHO; }).length, r = row + 1 + k;
    R(r, 1, 1, N).setValues([[k + 1, x.ten + (x.d ? '' : ' (không có tab ' + x.tab + ')'), ds.length, '', dem('DUYET'), dem('CHO'), dem('TRAVE'), dem('CHUA'), tre]]); R(r, 3, 1, 2).merge();
    R(r, 1, 1, N).setHorizontalAlignment('center'); R(r, 2).setHorizontalAlignment('left').setFontWeight('bold');
    if (tre) R(r, 9).setFontColor('#C5221F').setFontWeight('bold');
  });
  R(row, 1, data.length + 1, N).setBorder(true, true, true, true, true, true, '#9AA5B4', SpreadsheetApp.BorderStyle.SOLID);
  row += data.length + 2;
  // Chi tiết từng hạng mục: ưu tiên quá hạn → trả về → đang chờ → chưa trình → đã duyệt
  var thuTu = { TRAVE: 1, CHO: 2, CHUA: 3, DUYET: 4 }, mau = { DUYET: '#E6F4EA', CHO: '#FEF7E0', TRAVE: '#FCE8E6', CHUA: '#F1F3F6' };
  data.forEach(function (x) {
    var ds = ((x.d && x.d.ds) || []).slice().sort(function (a, b) { return ((b.cho || 0) > TQN_BC.NGAY_CHO) - ((a.cho || 0) > TQN_BC.NGAY_CHO) || thuTu[a.loai] - thuTu[b.loai] || (b.cho || 0) - (a.cho || 0); });
    R(row, 1, 1, N).merge().setValue((x.tab === 'SD' ? 'I. ' : 'II. ') + x.ten.toUpperCase() + ' – ' + ds.length + ' hồ sơ').setFontWeight('bold').setBackground('#E7F3F1'); row++;
    R(row, 1, 1, N).setValues([['STT', 'Mã hồ sơ', 'Nội dung', 'Rev', 'Tình trạng', 'Ngày trình', 'Số ngày chờ', 'Người thực hiện', 'Vướng mắc / ghi chú']]).setFontWeight('bold').setBackground('#F1F3F6').setHorizontalAlignment('center').setWrap(true); row++;
    if (x.d && x.d.loi) { R(row, 1, 1, N).merge().setValue(x.d.loi).setFontColor('#C5221F'); row += 2; return; }
